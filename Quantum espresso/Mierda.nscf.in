C
Mgb2
 &CONTROL
                 calculation = 'scf' ,
                restart_mode = 'from_scratch' ,
                      outdir = 'temp' ,
                  pseudo_dir = '.' ,
                      prefix = 'Mgb2' ,
                     tstress = .true. ,
                     tprnfor = .true. ,
 /
 &SYSTEM
                       ibrav = 4,
                   celldm(1) = 5.860,
                   celldm(3) = 1.093,
                         nat = 3,
                        ntyp = 2,
                     ecutwfc = 40 ,
                     ecutrho = 160 ,
                 occupations = "smearing" ,
                     degauss = 0.025 ,
 /
 &ELECTRONS
                    conv_thr = 1.0d-7 ,
                 mixing_mode = 'plain' ,
                 mixing_beta = 0.7 ,
 /
